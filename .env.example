# Flask Settings
SECRET_KEY=generate-a-long-random-string-here
FLASK_APP=run.py
FLASK_ENV=development
GOOGLE_REDIRECT_URI=http://localhost:5000/admin/oauth2callback

# Google Drive Service Account (optional)
# Set this to the JSON content of a service account key, or keep it unset to use user OAuth.
# GOOGLE_DRIVE_CREDENTIALS={"type": "service_account", ...}
# GOOGLE_DRIVE_FOLDER_ID=your_drive_folder_id_here

# Database (Uncomment to use PostgreSQL locally instead of SQLite)
# DATABASE_URL=postgresql://postgres:password123@localhost:5432/voltride_db

# Stripe Keys (Get these from your Stripe Dashboard -> Developers -> API keys)
STRIPE_PUBLIC_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
